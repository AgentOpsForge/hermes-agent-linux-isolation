+++ b/tests/hermes_cli/test_kanban_lock_symlink.py
@@ -0,0 +1,51 @@
+"""Local patch P-07: kanban lock files follow a symlinked board database."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+
+
+@pytest.fixture
+def linked_board(tmp_path):
+    target_dir = tmp_path / "kanban" / "default"
+    target_dir.mkdir(parents=True)
+    target = target_dir / "kanban.db"
+    target.touch()
+    root = tmp_path / "root"
+    root.mkdir()
+    link = root / "kanban.db"
+    link.symlink_to(target)
+    os.chmod(root, 0o555)
+    yield link, target_dir, root
+    os.chmod(root, 0o755)
+
+
+@pytest.mark.skipif(os.geteuid() == 0, reason="root ignores directory permissions")
+def test_init_lock_lives_next_to_target(linked_board):
+    link, target_dir, root = linked_board
+    with kbc._cross_process_init_lock(link):
+        pass
+    assert (target_dir / "kanban.db.init.lock").exists()
+    assert not (root / "kanban.db.init.lock").exists()
+
+
+@pytest.mark.skipif(os.geteuid() == 0, reason="root ignores directory permissions")
+def test_dispatch_lock_is_really_held_behind_readonly_link_dir(linked_board):
+    link, target_dir, root = linked_board
+    with kbc._dispatch_tick_lock(link) as held:
+        assert held is True
+        assert (target_dir / "kanban.db.dispatch.lock").exists()
+        # a second holder must lose: the lock is real, not the read-only no-op fallback
+        with kbc._dispatch_tick_lock(target_dir / "kanban.db") as second:
+            assert second is False
+    assert not (root / "kanban.db.dispatch.lock").exists()
+
+
+def test_plain_path_unchanged(tmp_path):
+    db = tmp_path / "kanban.db"
+    assert kbc._lock_anchor(db) == db
