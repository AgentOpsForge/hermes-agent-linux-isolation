+def _lock_anchor(path: Path) -> Path:
+    """Local patch P-07: place board lock files next to the real database.
+
+    SQLite follows a symlinked ``kanban.db`` and writes ``-wal``/``-shm`` next to the
+    TARGET; the init and dispatch locks must live there too, otherwise a read-only
+    directory holding only the link breaks every connect (and silently disables the
+    single-writer dispatch lock). ``repair`` already locks the resolved path."""
+    with contextlib.suppress(OSError, RuntimeError):
+        if path.is_symlink():
+            return path.resolve()
+    return path
+
+
 @contextlib.contextmanager
 def _cross_process_init_lock(path: Path):
     """Serialize first-connect WAL/schema/integrity setup across processes.
@@ -126,6 +139,7 @@ def _cross_process_init_lock(path: Path):
     because ``_INIT_LOCK`` still serializes same-process threads and init is
     idempotent: two racing first-inits mean redundant work, not corruption.
     """
+    path = _lock_anchor(path)
     path.parent.mkdir(parents=True, exist_ok=True)
     lock_path = path.with_name(path.name + ".init.lock")
     handle = lock_path.open("a+b")
@@ -177,6 +191,7 @@ def _dispatch_tick_lock(db_path: Path):
     lock is the defense-in-depth that prevents two dispatchers from ever writing concurrently *regardless of
     how the second one got there*.
     """
+    db_path = _lock_anchor(db_path)
     lock_path = db_path.with_name(db_path.name + ".dispatch.lock")
     handle = None
     acquired = False
