index 0000000..600fb31
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_foreign_worker.py
@@ -0,0 +1,35 @@
+"""A worker owned by another user (invisible in /proc, kill(0) -> EPERM) is not reclaimed as dead."""
+import os
+
+import pytest
+
+from hermes_cli import kanban_db_dispatch as kd
+
+
+@pytest.mark.skipif(os.name != "posix", reason="POSIX kill(0) semantics")
+def test_foreign_worker_counts_as_alive(monkeypatch):
+    def eperm(pid, sig):
+        raise PermissionError(1, "Operation not permitted")
+
+    monkeypatch.setattr(kd.os, "kill", eperm)
+    monkeypatch.setattr(kd._kb, "_pid_alive", lambda pid: False)  # invisible in /proc
+    assert kd._foreign_live_pid(4242) is True
+    assert kd._worker_alive(4242, "epoch:|123") is True
+
+
+@pytest.mark.skipif(os.name != "posix", reason="POSIX kill(0) semantics")
+def test_dead_worker_still_dead(monkeypatch):
+    def gone(pid, sig):
+        raise ProcessLookupError(3, "No such process")
+
+    monkeypatch.setattr(kd.os, "kill", gone)
+    monkeypatch.setattr(kd._kb, "_pid_alive", lambda pid: False)
+    assert kd._foreign_live_pid(4242) is False
+    assert kd._worker_alive(4242, "epoch:|123") is False
+
+
+def test_own_worker_uses_normal_checks(monkeypatch):
+    monkeypatch.setattr(kd.os, "kill", lambda pid, sig: None)  # same user: kill(0) succeeds
+    monkeypatch.setattr(kd._kb, "_pid_alive", lambda pid: False)
+    assert kd._foreign_live_pid(4242) is False
+    assert kd._worker_alive(4242, "epoch:|123") is False
