+def _foreign_live_pid(pid: Optional[int]) -> bool:
+    """True when ``pid`` exists but belongs to another user: ``kill(pid, 0)`` fails with EPERM.
+
+    With one gateway per profile, each running as its own user and dispatching only its own
+    profile (``kanban.dispatch_profiles``), every gateway still sweeps every running task of the
+    board. Under ``ProtectProc=invisible`` (systemd) or ``hidepid`` another user's worker is
+    absent from ``/proc``, so the existence and fingerprint checks call it dead and a foreign
+    gateway reclaims a live worker. EPERM proves the process exists; whether it is still the
+    worker is for its own gateway, which can see it, to decide.
+    """
+    if not pid or os.name != "posix":
+        return False
+    try:
+        os.kill(int(pid), 0)
+    except PermissionError:
+        return True
+    except (OSError, ValueError):
+        return False
+    return False
+
