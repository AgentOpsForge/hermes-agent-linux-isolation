+def _dispatch_lock_scope(kanban_cfg) -> str:
+    """Lock-name suffix for a non-empty ``kanban.dispatch_profiles`` allowlist, else ''."""
+    raw = kanban_cfg.get("dispatch_profiles") if isinstance(kanban_cfg, dict) else None
+    if raw is None:
+        return ""
+    names = [str(n) for n in raw] if isinstance(raw, (list, tuple)) else str(raw).split(",")
+    names = sorted({re.sub(r"[^a-z0-9_-]", "", n.strip().lower()) for n in names} - {""})
+    return "+".join(names)
+
