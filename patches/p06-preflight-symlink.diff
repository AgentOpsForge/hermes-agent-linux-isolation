+++ b/hermes_state_repair.py
@@ -548,6 +548,11 @@ def preflight_db_writability(db_path: Path, *, db_label: str = "state.db") -> No
     """
     if str(db_path) == ":memory:" or str(db_path).startswith("file:"):
         return
+    # Local patch P-06: SQLite follows a symlinked database path and creates the -wal/-shm sidecars
+    # next to the TARGET, so check the resolved location, not the directory holding the link.
+    with contextlib.suppress(OSError, RuntimeError):
+        if Path(db_path).is_symlink():
+            db_path = Path(db_path).resolve()
     home: Optional[Path] = None
     with contextlib.suppress(Exception):  # pragma: no cover - defensive
         home = Path(get_hermes_home()).resolve()
