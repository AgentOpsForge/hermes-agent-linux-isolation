+
+
+class TestSymlinkedDatabase:
+    """Local patch P-06: a symlinked DB is checked where SQLite writes its sidecars (the target)."""
+
+    def test_readonly_link_dir_with_writable_target_passes(self, hermes_home, tmp_path):
+        target_dir = tmp_path / "boards" / "default"
+        target_dir.mkdir(parents=True)
+        _make_db(target_dir / "kanban.db")
+        link_dir = tmp_path / "root"
+        link_dir.mkdir()
+        link = link_dir / "kanban.db"
+        link.symlink_to(target_dir / "kanban.db")
+        os.chmod(link_dir, 0o555)
+        try:
+            preflight_db_writability(link, db_label="kanban.db")  # must not raise
+            assert not os.access(link_dir, os.W_OK)               # and must not chmod the link dir
+        finally:
+            os.chmod(link_dir, 0o755)
+
+    def test_readonly_target_dir_still_refused(self, hermes_home, tmp_path):
+        target_dir = tmp_path / "ro-target"
+        target_dir.mkdir()
+        _make_db(target_dir / "kanban.db")
+        link = tmp_path / "kanban.db"
+        link.symlink_to(target_dir / "kanban.db")
+        os.chmod(target_dir, 0o555)
+        try:
+            with pytest.raises(sqlite3.OperationalError):
+                preflight_db_writability(link, db_label="kanban.db")
+        finally:
+            os.chmod(target_dir, 0o755)
